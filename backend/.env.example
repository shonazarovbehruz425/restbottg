# ========================================================
# RESTORAN TELEGRAM BOT VA TIZIM KONFIGURATSIYASI (.env.example)
# Nusxa olish:  copy .env.example .env  (Windows)
#               cp .env.example .env     (Linux/Mac)
# So'ng .env ichini o'z qiymatlaringiz bilan to'ldiring.
# BU FAYLNI GitHub ga push qilish mumkin. Real token yozmang!
# ========================================================

# 1. Server Porti
PORT=5000

# 2. Telegram Bot Tokeni (@BotFather dan olingan token)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# 3. Buyurtmalar (Oshxona / Adminlar) Telegram Kanal ID si (DOIMIY SAQLANADI)
# Masalan: -1001234567890 yoki @oshxona_kanali
TELEGRAM_ORDERS_CHANNEL_ID=

# 4. Telegram Mini App Web URL manzili
# Lokal test uchun: http://localhost:5173 yoki ngrok https link
TELEGRAM_MINI_APP_URL=http://localhost:5173

# 5. Web Admin Panel Kirish Ma'lumotlari (Login va Parol)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password

# 5b. Web Admin Panel Linki / Yo'li (default: /admin)
ADMIN_PATH=/admin
# ADMIN_URL=http://localhost:5174

# 5c. Kuryer Paneli Linki / Yo'li (default: /courier)
COURIER_PATH=/courier
# COURIER_URL=http://localhost:5173/courier

# 6. NEON.TECH POSTGRESQL MA'LUMOTLAR BAZASI (TAVSIYA ETILADI)
# Neon.tech konsolidan olingan connection string (agar bo'sh bo'lsa SQLite fallback ishlaydi)
# Masalan: postgresql://neondb_owner:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 7. CLOUDFLARE R2 BULUTLI RASM SAQLASH (IMAGE STORAGE)
# Cloudflare Dashboard -> R2 -> API Tokens bo'limidan olingan kalitlar
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=restaurant-images
# R2 Public bucket URL yoki Custom Domain (masalan: https://pub-xyz.r2.dev yoki https://images.yourdomain.com)
R2_PUBLIC_URL=

# 8. CORS ruxsat berilgan originlar (vergul bilan)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# 9. Ixtiyoriy: SQLite va mahalliy upload yo'llari (DATABASE_URL bo'lmaganda)
DB_PATH=
UPLOADS_DIR=
